# Copy this file to .env and fill in real values. Never commit .env.
# Values shown are placeholders, not working keys.

# Required
GROQ_API_KEY=your-groq-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key

# Optional: Groq model and output budget (defaults shown)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=2048
# low | medium | high for gpt-oss models. Set to an empty value to omit it.
GROQ_REASONING_EFFORT=low

# Optional: limits on the evidence sent to the analysis model (defaults shown)
ANALYSIS_MAX_EVIDENCE_ITEMS=10
ANALYSIS_MAX_EXCERPT_CHARS=500
ANALYSIS_MAX_EVIDENCE_CHARS=9000
